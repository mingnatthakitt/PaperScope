# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Local assets and database
PAPERS_ROOT=./data/papers
DATABASE_URL=postgresql+psycopg://paperscope:paperscope@127.0.0.1:5432/paperscope

# Gemini document analysis
GOOGLE_AI_API_KEY=
PAPER_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_MODEL_MAX_RETRIES=2

# NVIDIA NIM / OpenAI-compatible endpoint
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
RAG_PRIMARY_MODEL=meta/muse-glimmer-30b
RAG_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
RAG_PRIMARY_MAX_RETRIES=2
RAG_FALLBACK_MAX_RETRIES=2
RAG_TIMEOUT_SECONDS=60
RAG_PROVIDER_TIMEOUT_SECONDS=18
RAG_CIRCUIT_BREAKER_FAILURES=3
RAG_CIRCUIT_BREAKER_COOLDOWN_SECONDS=90
RAG_RATE_LIMIT_PER_MINUTE=30

# Ingestion worker recovery
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=600
INGESTION_RETRY_BACKOFF_SECONDS=5

# Local embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=auto

# Discovery
SEMANTIC_SCHOLAR_API_KEY=
DISCOVERY_TIMEOUT_SECONDS=20
DISCOVERY_PROVIDER_TIMEOUT_SECONDS=8
DISCOVERY_HTTP_TIMEOUT_SECONDS=6
